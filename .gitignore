# ============================================================
# StockSense .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
.Python

# --- Node.js ---
node_modules/

# --- Next.js ---
.next/
out/

# --- Testing & Coverage ---
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Database ---
*.sqlite3
*.db

# --- Docker ---
# Don't ignore docker-compose.yml, but ignore local overrides
docker-compose.override.yml
