# ============================================================
# StockSense Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME=StockSense
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql://stocksense:change_me_to_a_strong_password@localhost:5432/stocksense

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
